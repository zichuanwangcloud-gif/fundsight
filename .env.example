# 盈见 FundSight —— AI 分析助手配置模板
#
# 用法:复制本文件为 .env,填入真实值,再 `docker compose up -d`(compose 自动加载同目录 .env)。
# .env 已被 .gitignore 排除,真实密钥不会入库。全部变量可选,未设则 AI 功能优雅降级。

# provider:anthropic(默认)| openai(含 OpenAI 兼容端点,如国产模型 / 中转站)
FUNDSIGHT_AI_PROVIDER=openai

# base url —— 填完整 endpoint 路径,不是只填域名:
#   openai 兼容:https://你的域名/v1/chat/completions
#   anthropic  :https://api.anthropic.com/v1/messages
FUNDSIGHT_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# 模型名(不设按 provider 取默认:anthropic→claude-sonnet-5,openai→gpt-4o-mini)
FUNDSIGHT_AI_MODEL=gpt-4o-mini

# 单次回复 token 上限(不设默认 8192)。推理模型(reasoning model,如 glm/o 系列)会把
# 大量 token 花在隐藏思考上且计入此上限,卡太低会导致正文被从中间截断;如遇截断可调高。
FUNDSIGHT_AI_MAX_TOKENS=8192

# api key(未设时后端回退读 ANTHROPIC_API_KEY,与截图识别共用)
FUNDSIGHT_AI_API_KEY=sk-xxxxxxxxxxxxxxxx
